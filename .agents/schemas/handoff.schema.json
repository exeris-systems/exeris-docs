{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff (exeris-docs)",
  "description": "The bundle's shape, narrowed to this repository's roles. The shape is not restated here: if a field's meaning is in question, the base is the answer. agents-md-schema.md rule 13.",
  "allOf": [
    { "$ref": "../vendor/exeris-agents-1.2.0/schemas/handoff.base.schema.json" },
    {
      "properties": {
        "from": { "$ref": "#/$defs/agent" },
        "to":   { "$ref": "#/$defs/agent" }
      }
    }
  ],
  "$defs": {
    "agent": {
      "enum": [
        "exeris-docs-router",
        "exeris-docs-architect",
        "exeris-docs-adr-registry-keeper",
        "exeris-docs-document-shape-classifier",
        "exeris-docs-implementer",
        "exeris-docs-evaluator",
        "human"
      ]
    }
  }
}
