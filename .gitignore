.idea/

# Working material. Directories starting with "_" are local-only by convention — the
# documentation validators skip them (scripts/_common.py walk_md) and they hold the
# Phase 0 inventory, the reference research and the org-github bundle, none of which
# is repository content. Same rule as exeris-kernel's docs/release/ working notes.
standards/_*/

# Local git worktrees parked inside the repo. Tracked .claude/ holds generated adapters, so the
# ignore is this subdirectory and not the provider tree. `git add -A` committed one as a gitlink
# on 2026-09-07, which would have broken every clone.
.claude/worktrees/

# Session state written by the L0 hooks. The dispatcher keys a subdirectory per session, so this
# is per-session scratch and never repository content.
.agents-state/
